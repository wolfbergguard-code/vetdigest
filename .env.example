# VetRadiometry Digest — секреты
# Скопируйте этот файл в .env и заполните значения.
# chmod 600 .env — ОБЯЗАТЕЛЬНО.

# Perplexity Sonar API — получить на https://www.perplexity.ai/settings/api
PPLX_API_KEY=pplx-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Telegram-бот (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=5133321557

# NCBI (PubMed) — свой email, идентифицирует клиента, лимит 10 req/s без API-ключа
NCBI_EMAIL=wolfberg.guard@gmail.com
NCBI_TOOL=VetRadiometryDigest
