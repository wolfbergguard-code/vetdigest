# VetDigest v2 — секреты. chmod 600 .env — ОБЯЗАТЕЛЬНО.
# Формат строго КЛЮЧ=значение, без кавычек и пробелов вокруг "=".

# Perplexity Sonar API
PPLX_API_KEY=pplx-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Основной чат (с кнопками оценки)
TELEGRAM_CHAT_ID=5133321557
# Второй чат: только название, ссылка и перевод абстракта. Пусто = не слать.
# Узнать id: добавить бота в чат/канал (в канал — админом) и написать /chatid
SECONDARY_CHAT_ID=
# 1 = во второй чат в понедельник 15:00 МСК (vetdigest-secondary.timer), 0 = сразу с основным
SECONDARY_DELAYED=1
# номер темы в группе с темами (из ссылки t.me/c/<группа>/<тема>), пусто = общая тема
SECONDARY_THREAD_ID=

# NCBI (PubMed)
NCBI_EMAIL=wolfberg.guard@gmail.com
NCBI_TOOL=VetRadiometryDigest
NCBI_API_KEY=

# Semantic Scholar (необязательно; без ключа работает медленнее)
S2_API_KEY=

# Тонкая настройка (необязательно)
VETDIGEST_MAX_LLM=50
VETDIGEST_MAX_CARDS=15
VETDIGEST_MIN_SCORE=6
